{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SecurityPolicy": {
    "Enabled": true,
    "ScriptSrc": "'self' 'wasm-unsafe-eval' 'unsafe-inline'",
    "ConnectSrc": "'self' https://api.trusted.com wss:",
    "StyleSrc": "'self' 'unsafe-inline'",
    "ImgSrc": "'self' data: https:",
    "ObjectSrc": "'none'",
    "DefaultSrc": "'self'",
    "ReportUri": ""
  }
}
